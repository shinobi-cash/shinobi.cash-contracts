# =============================================================================
# Shinobi.cash Contracts - Environment Variables
# =============================================================================
# Copy to .env and fill in values. Never commit .env to git.

# Deployer private key (0x prefixed)
PRIVATE_KEY=0x_your_private_key_here

# RPC URLs
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Block explorer API keys (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
BASESCAN_API_KEY=your_basescan_api_key_here

# =============================================================================
# DEPLOYMENT
# =============================================================================
# Pool and origin chain configs are in script/config/pools/ and script/config/origins/
# See script/pool/README.md for the full deployment pipeline.
#
# Example:
#   POOL_KEY=arbitrum-sepolia forge script script/pool/01_Deploy_Verifiers.s.sol \
#     --rpc-url arbitrum-sepolia --broadcast --verify

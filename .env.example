# Private key for deployment and testing
PRIVATE_KEY=your_private_key_here

# RPC URL for blockchain network
RPC_URL=https://your-rpc-url-here

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here


# =============================================================================
# CHAIN CONFIGURATION
# =============================================================================
DESTINATION_CHAIN_ID=421614  # Arbitrum Sepolia chain ID

# =============================================================================
# ORACLE CONFIGURATION
# =============================================================================
# NOTE: All oracles should point to HyperlaneOracle addresses after deploying
# step 05_DeployHyperlaneOracles. The MockOracle addresses below are for testing only.
#
# Oracle role explanation:
# - INTENT_ORACLE: Validates intent proofs (origin → destination)
# - FILL_ORACLE: Validates fill proofs (destination → origin)
# - OUTPUT_ORACLE: Oracle specified in intent output (for fill proof relay)
# - DESTINATION_ORACLE: Oracle on destination chain for output validation
#
# For Hyperlane integration, all oracles on the same chain use the same HyperlaneOracle:
# - Arbitrum: INTENT_ORACLE_ARBITRUM = FILL_ORACLE_ARBITRUM = DESTINATION_ORACLE_ARBITRUM = HYPERLANE_ORACLE_ARBITRUM
# - Base: FILL_ORACLE_BASE = OUTPUT_ORACLE_BASE = HYPERLANE_ORACLE_BASE

# Arbitrum Sepolia Oracles (all point to same HyperlaneOracle after deployment)
INTENT_ORACLE_ARBITRUM_SEPOLIA=0x4cb20f4415d3666e5d92e261de98fc9b7843d036
FILL_ORACLE_ARBITRUM_SEPOLIA=0x4cb20f4415d3666e5d92e261de98fc9b7843d036
DESTINATION_ORACLE_ARBITRUM_SEPOLIA=0x4cb20f4415d3666e5d92e261de98fc9b7843d036

# Base Sepolia Oracles (all point to same HyperlaneOracle after deployment)
FILL_ORACLE_BASE_SEPOLIA=0x52Fe5095D9458396e2926d89BC7730DDd2C81404
OUTPUT_ORACLE_BASE_SEPOLIA=0x52Fe5095D9458396e2926d89BC7730DDd2C81404

# =============================================================================
# DEPLOYMENT SCRIPTS - Execute in order
# =============================================================================

# --- STEP 01: Deploy Verifiers (Arbitrum Sepolia) ---
# forge script script/01_DeployVerifiers.s.sol:DeployVerifiers --rpc-url arbitrum-sepolia --broadcast --verify
WITHDRAWAL_VERIFIER=0x1A6ffA02c307A1856D5ffA9432545012eb929aad
COMMITMENT_VERIFIER=0x020507eAb83152E19c5B8A3234385d4423Ed3185
CROSSCHAIN_WITHDRAWAL_VERIFIER=0x0cd36b4d2ff17F08200F5E07871E8D796de57896
WITHDRAW2_VERIFIER=0x11Ce8937b38487CDeec8C5c4a08792b58dCd41d6
CROSSCHAIN_WITHDRAW2_VERIFIER=0x7706fAa188aee2DC828A0a431121bD8864993AcC

# --- STEP 02: Deploy Entrypoint (Arbitrum Sepolia) ---
# forge script script/02_DeployEntrypoint.s.sol:DeployEntrypoint --rpc-url arbitrum-sepolia --broadcast --verify
SHINOBI_CASH_ENTRYPOINT_PROXY=0x1960c967e9e7248872E04135513C524556B4323E
SHINOBI_CASH_ENTRYPOINT_BLOCK_NUMBER=239163971

# --- STEP 03: Deploy Privacy Pool (Arbitrum Sepolia) ---
# forge script script/03_DeployPrivacyPool.s.sol:DeployPrivacyPool --rpc-url arbitrum-sepolia --broadcast --verify
SHINOBI_CASH_ETH_POOL=0xD8d24CfAfC44FEbb6e95635C0D2EF127D5DD925e
SHINOBI_CASH_ETH_POOL_BLOCK_NUMBER=239164297

# --- STEP 04: Deploy Input Settler (Arbitrum Sepolia) ---
# forge script script/04_DeployInputSettlerArbitrum.s.sol:DeployInputSettlerArbitrum --rpc-url arbitrum-sepolia --broadcast --verify
INPUT_SETTLER_ARBITRUM_SEPOLIA=0x8CC23a5652395217Ba281F1Edf26f6E237F2C6af
INPUT_SETTLER_ARBITRUM_SEPOLIA_BLOCK_NUMBER=239164583

# --- STEP 05: Deploy Hyperlane Oracles (BOTH chains) ---
# ⚠️ IMPORTANT: Deploy these BEFORE steps 06 and 09 (output settlers need oracle addresses)
#
# On Base Sepolia:
# forge script script/05_DeployHyperlaneOracles.s.sol:DeployHyperlaneOracles --rpc-url base-sepolia --broadcast --verify
HYPERLANE_ORACLE_BASE_SEPOLIA=
HYPERLANE_ORACLE_BASE_SEPOLIA_BLOCK_NUMBER=

# On Arbitrum Sepolia:
# forge script script/05_DeployHyperlaneOracles.s.sol:DeployHyperlaneOracles --rpc-url arbitrum-sepolia --broadcast --verify
HYPERLANE_ORACLE_ARBITRUM_SEPOLIA=
HYPERLANE_ORACLE_ARBITRUM_SEPOLIA_BLOCK_NUMBER=

# Hyperlane gas limit for cross-chain messages (default: 200000)
HYPERLANE_GAS_LIMIT=200000

# --- STEP 06: Deploy Deposit Output Settler (Arbitrum Sepolia) ---
# ⚠️ Requires INTENT_ORACLE_ARBITRUM_SEPOLIA = HYPERLANE_ORACLE_ARBITRUM_SEPOLIA
# forge script script/06_DeployDepositOutputSettlerArbitrum.s.sol:DeployDepositOutputSettlerArbitrum --rpc-url arbitrum-sepolia --broadcast --verify
DEPOSIT_OUTPUT_SETTLER_ARBITRUM_SEPOLIA=0x1861270CC3e1fd6B75634d61d420123724cd1B17
DEPOSIT_OUTPUT_SETTLER_ARBITRUM_SEPOLIA_BLOCK_NUMBER=239164779

# --- STEP 07: Deploy Deposit Entrypoint (Base Sepolia) ---
# forge script script/07_DeployDepositEntrypoint.s.sol:DeployDepositEntrypoint --rpc-url base-sepolia --broadcast --verify
SHINOBI_CASH_DEPOSIT_ENTRYPOINT_BASE_SEPOLIA=0x62cacAa2045fC31deFdE0BbbaD0fC47f32792C54
SHINOBI_CASH_DEPOSIT_ENTRYPOINT_BASE_SEPOLIA_BLOCK_NUMBER=37135360

# --- STEP 08: Deploy Input Settler (Base Sepolia) ---
# forge script script/08_DeployInputSettlerBase.s.sol:DeployInputSettlerBase --rpc-url base-sepolia --broadcast --verify
INPUT_SETTLER_BASE_SEPOLIA=0x07048A392243b30c9166eb36C5790d9D343e0e58
INPUT_SETTLER_BASE_SEPOLIA_BLOCK_NUMBER=37135392

# --- STEP 09: Deploy Withdrawal Output Settler (Base Sepolia) ---
# ⚠️ Requires FILL_ORACLE_ARBITRUM_SEPOLIA = HYPERLANE_ORACLE_ARBITRUM_SEPOLIA
# forge script script/09_DeployWithdrawalOutputSettlerBase.s.sol:DeployWithdrawalOutputSettler --rpc-url base-sepolia --broadcast --verify
WITHDRAWAL_OUTPUT_SETTLER_BASE_SEPOLIA=0x0F4b4c45297EEa5adb1DdbE5E94E01Fe7B787a85
WITHDRAWAL_OUTPUT_SETTLER_BASE_SEPOLIA_BLOCK_NUMBER=37135412

# --- STEP 10: Setup Entrypoint (Arbitrum Sepolia) ---
# forge script script/10_SetupEntrypoint.s.sol:SetupEntrypoint --rpc-url arbitrum-sepolia --broadcast

# --- STEP 11: Setup Deposit Entrypoint (Base Sepolia) ---
# forge script script/11_SetupDepositEntrypoint.s.sol:SetupDepositEntrypoint --rpc-url base-sepolia --broadcast

# --- STEP 12: Setup Deposit Output Settler (Arbitrum Sepolia) ---
# Configures origin chain (Base Sepolia) for intent proof validation
# forge script script/12_SetupDepositOutputSettler.s.sol:SetupDepositOutputSettler --rpc-url arbitrum-sepolia --broadcast

# --- STEP 13: Deploy Paymasters (Arbitrum Sepolia) ---
# forge script script/13_DeployPaymasters.s.sol:DeployPaymasters --rpc-url arbitrum-sepolia --broadcast --verify
SIMPLE_PAYMASTER=0x2D5F036022D611B84B4bD4843666795168c83f7c
SIMPLE_PAYMASTER_BLOCK_NUMBER=239165983
CROSS_CHAIN_PAYMASTER=0x11deb768B97F465C52D91ad3271B1a6147e16fE7
CROSSCHAIN_PAYMASTER_BLOCK_NUMBER=239165996
WITHDRAW2_PAYMASTER=0x498CB728B62146d324449f7a75E784bd4162a639
WITHDRAW2_PAYMASTER_BLOCK_NUMBER=239189801
CROSSCHAIN_WITHDRAW2_PAYMASTER=0x319743dD9A4E7c17f7d83121327E3A48b7E7Ac2f
CROSSCHAIN_WITHDRAW2_PAYMASTER_BLOCK_NUMBER=239166013

# =============================================================================
# PRIVACY POOL CONFIGURATION
# =============================================================================
MINIMUM_DEPOSIT_AMOUNT=100000000000000  # 0.0001 ETH in wei (1e15)
VETTING_FEE_BPS=10                       # 0.1% fee (100 basis points)
MAX_RELAY_FEE_BPS=1500                   # 15% max relay fee (1500 basis points)
